doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Clean Blog - Start Bootstrap Theme

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body

        include includes/navbar.pug

        // Page Header
        header.masthead(style="background-image: url('assets/img/home-bg.jpg')")
            .container.position-relative.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center
                    .col-md-10.col-lg-8.col-xl-7
                        .site-heading
                            h1 Clean Blog
                            span.subheading A Blog Theme by Start Bootstrap

        // Main Content
        .container.px-4.px-lg-5
            .row.gx-4.gx-lg-5.justify-content-center
                .col-md-10.col-lg-8.col-xl-7

                    // Post previews as Bootstrap Cards, 2 per row
                    .row.justify-content-center
                        .col-sm-6.mb-4
                            // The whole card is the link, and the card clips its own content
                            a.card.post-card.h-100.text-decoration-none.text-dark.overflow-hidden(href='post.html')
                                img.card-img-top(src='assets/img/post-sample-image.jpg', alt='Man must explore, and this is exploration at its greatest')
                                .card-body
                                    h2.card-title.h5
                                        | Man must explore, and this is exploration at its greatest
                                    p.card-text
                                        | Problems look mighty small from 150 miles up
                        .col-sm-6.mb-4
                            // The whole card is the link, and the card clips its own content
                            a.card.post-card.h-100.text-decoration-none.text-dark.overflow-hidden(href='post.html')
                                img.card-img-top(src='assets/img/home-bg.jpg', alt='I believe every human has a finite number of heartbeats. I don\'t intend to waste any of mine.')
                                .card-body
                                    h2.card-title.h5
                                        | I believe every human has a finite number of heartbeats. I don't intend to waste any of mine.
                        .col-sm-6.mb-4
                            // The whole card is the link, and the card clips its own content
                            a.card.post-card.h-100.text-decoration-none.text-dark.overflow-hidden(href='post.html')
                                img.card-img-top(src='assets/img/about-bg.jpg', alt='Science has not yet mastered prophecy')
                                .card-body
                                    h2.card-title.h5
                                        | Science has not yet mastered prophecy
                                    p.card-text
                                        | We predict too much for the next year and yet far too little for the next ten.
                        .col-sm-6.mb-4
                            // The whole card is the link, and the card clips its own content
                            a.card.post-card.h-100.text-decoration-none.text-dark.overflow-hidden(href='post.html')
                                img.card-img-top(src='assets/img/contact-bg.jpg', alt='Failure is not an option')
                                .card-body
                                    h2.card-title.h5
                                        | Failure is not an option
                                    p.card-text
                                        | Many say exploration is part of our destiny, but it’s actually our duty to future generations.

                    // Pager
                    .d-flex.justify-content-center.mb-4
                        a.btn.btn-primary.text-uppercase(href='#!') Older Posts →
        
        include includes/footer.pug

        include includes/scripts.pug
